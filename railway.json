{
  "$schema": "https://railpack.com/schema.json",
  "build": {
    "steps": {
      "install-backend": {
        "inputs": ["."],
        "commands": [
          "cd backend",
          "npm install"
        ]
      }
    }
  },
  "deploy": {
    "startCommand": "cd backend && node server.js",
    "variables": {
      "NODE_ENV": "production",
      "PORT": "5000"
    }
  }
}